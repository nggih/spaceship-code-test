# Backend-only secrets. Copy to .env and never commit the populated file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
TURNSTILE_SECRET_KEY=

# Browser-safe settings
VITE_TURNSTILE_SITE_KEY=
VITE_API_URL=

# Local and production origins
ALLOWED_ORIGINS=http://localhost:15173
PUBLIC_APP_URL=http://localhost:15173
ENVIRONMENT=development

# Host ports (chosen to avoid common Vite/FastAPI conflicts)
FRONTEND_PORT=15173
BACKEND_PORT=18000
