# Backend-only secrets. Copy to .env and never commit the populated file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
TURNSTILE_SECRET_KEY=
AI_SESSION_SECRET=
# Password: 12–128 chars with uppercase, lowercase, number, symbol; no whitespace.
USERNAME=
PASSWORD=
AUTH_SESSION_SECRET=
TURNSTILE_AFTER_LOGIN=false

# Local Docker fallback identity when USERNAME/PASSWORD are blank.
DEV_AUTH_EMAIL=reviewer@local.test
HISTORY_DB_PATH=/tmp/logistics-history.db

# Optional Cloudflare Access identity settings.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Browser-safe settings
VITE_TURNSTILE_SITE_KEY=
VITE_API_URL=

# Local and production origins
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
ENVIRONMENT=development

# Docker Compose host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
